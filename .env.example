# AI Employee — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# Obsidian vault path (absolute path)
VAULT_PATH=D:/Hac3/Ai_Employee_Vault

# File Watcher settings (Bronze Tier)
WATCH_INTERVAL=5
LOG_RETENTION_DAYS=90

# Gmail Watcher settings (Silver Tier)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_POLL_INTERVAL=60
GMAIL_MAX_RESULTS=10

# WhatsApp Watcher settings (Silver Tier)
WHATSAPP_POLL_INTERVAL=30
WHATSAPP_SESSION_DIR=~/.ai_employee/whatsapp_session
WHATSAPP_KEYWORDS=urgent,invoice,payment,help,deadline,asap

# LinkedIn Poster settings (Silver Tier)
LINKEDIN_POST_MODE=simulate
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_SESSION_DIR=~/.ai_employee/linkedin_session

# Odoo Community settings (Gold Tier — XML-RPC via xmlrpc.client)
# Run: python scripts/odoo_mcp.py --setup-check  to diagnose uid=None errors
# Run: python scripts/odoo_mcp.py --list-dbs     to find your database name
ODOO_URL=http://localhost:8069
ODOO_DB=mycompany
ODOO_USER=admin
ODOO_PASSWORD=admin

# Facebook settings (Gold Tier — simulation mode by default)
FACEBOOK_POST_MODE=simulate
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_SESSION_DIR=~/.ai_employee/facebook_session

# Instagram settings (Gold Tier — simulation mode by default)
INSTAGRAM_POST_MODE=simulate
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_DEFAULT_IMAGE_URL=
INSTAGRAM_SESSION_DIR=~/.ai_employee/instagram_session
INSTAGRAM_PLACEHOLDER_IMAGE=

# Twitter/X settings (Gold Tier — simulation mode by default)
TWITTER_POST_MODE=simulate
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
